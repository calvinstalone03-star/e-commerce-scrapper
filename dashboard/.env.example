# Copy to .env.local for development, or set these in the deployment's
# environment. Nothing here is secret in the local case; the hosted one is.

# The database the dashboard reads. Locally this is the same Postgres the
# scraper writes to; deployed it is the hosted one (Neon), and it must be the
# POOLED connection string — the direct endpoint holds a connection per
# instance and a serverless deployment has many.
#
#   local  postgresql://calvin@127.0.0.1:5432/ecom_scraper
#   neon   postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/<db>?sslmode=require
DATABASE_URL=postgresql://calvin@127.0.0.1:5432/ecom_scraper

# Deployed, DATABASE_URL is required: without it the dashboard refuses to start
# rather than falling back to a localhost Postgres that is not there.

# Connections per instance. Defaults to 8 locally and 1 on Vercel, which is
# what you want in both cases; set it only if you have measured a reason to.
# DATABASE_POOL_MAX=1

# --- The login ---------------------------------------------------------------
# What the credential row is seeded with the first time the dashboard runs
# against an empty database. Read only at that moment: once the row exists these
# are ignored, so changing the password on /settings sticks and clearing these
# locks nobody out.
#
# Set DASHBOARD_PASSWORD before the first deploy. Without it the seed is the
# published default (admin / ecom123, in the README), and a deployment is on the
# public internet from the first request it answers.
# DASHBOARD_USERNAME=admin
# DASHBOARD_PASSWORD=

# The scraper's own settings (scraper/config.py) are read from the repo root
# .env, not this file. This one is the dashboard's.

# --- Notifications ------------------------------------------------------------
# The /notifications page needs no configuration: it reads this same database,
# and how far you have read is a row in `notify_seen`. The one setting it shares
# with the product table is below.

# How old the comparison snapshot must be before a price difference counts as a
# price change. Captures minutes apart disagree about price without anything
# having been repriced — 37 of 38 pairs 1.5-3.5 hours apart differ, against 3 of
# 1,335 a day apart — so comparing against the immediately preceding snapshot
# reports mostly artefacts. Set 0 to compare against whatever came before.
#
# Named NOTIFY_ for the notifier that first needed it; the product table's
# movement badge reads the same value through lib/price-change.ts, so the badge
# and the notifications page cannot disagree about what counts as a change.
# NOTIFY_MIN_GAP_HOURS=12
