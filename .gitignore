.venv/
.env
# Cookie jars are live sessions. COOKIES_PATH is configurable, so match the
# material and not just the default filename: `COOKIES_PATH=shopee-cookies.json`
# used to produce a file no rule covered, which `git add -A` then staged.
cookies.json
*cookies*.json
*.jar.json
*.tmp
.recon/
__pycache__/
*.pyc

# build / test artifacts
*.egg-info/
.pytest_cache/
.DS_Store
.ingest-token
# Pairing state: whether an extension has ever collected the token, and whether
# `ecom-scraper pair` has reopened the window. Local facts about one machine.
.ingest-paired
.ingest-pairing

# launchd logs
logs/

# Dashboard login credentials (hashed, plus the session signing key)
.dashboard-auth.json

# Stray npm/vitest caches: running a dashboard command from the repo root
# creates one here, and `git add -A` will stage it.
node_modules/
