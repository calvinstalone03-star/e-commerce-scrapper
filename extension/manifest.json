{
  "manifest_version": 3,
  "name": "ecom-scraper collector",
  "version": "0.2.0",
  "description": "Reads Shopee listings off pages you have open and files them into your local ecom-scraper database.",
  "permissions": ["storage", "alarms", "tabs", "scripting"],
  "host_permissions": [
    "http://127.0.0.1:8787/*",
    "*://shopee.co.id/*"
  ],
  "content_scripts": [
    {
      "matches": ["*://shopee.co.id/*"],
      "js": ["interceptor.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["*://shopee.co.id/*"],
      "js": ["bridge.js", "dom-scraper.js"],
      "world": "ISOLATED",
      "run_at": "document_start"
    }
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "ecom-scraper collector",
    "default_popup": "popup.html"
  }
}
