DATABASE_URL=postgresql://calvin@127.0.0.1:5432/ecom_scraper
SHOPEE_USERNAME=
SHOPEE_PASSWORD=
HEADLESS=true
MIN_DELAY=2.0
MAX_DELAY=5.0

# --- Shopee Affiliate Open API (supported route to keyword search) -----------
# Register at https://affiliate.shopee.co.id/ , then Open API section of the
# dashboard. When BOTH are set, the affiliate adapter is used for Shopee instead
# of web scraping. Web scraping cannot reach keyword search at all.
SHOPEE_AFFILIATE_APP_ID=
SHOPEE_AFFILIATE_APP_SECRET=
SHOPEE_AFFILIATE_REGION=id

# Ingest token for the browser extension (generated at .ingest-token if unset)
INGEST_TOKEN=

# Skip a snapshot identical to the previous one within this many hours (0 = always insert)
SNAPSHOT_DEDUPE_HOURS=24

# --- The hosted database (README section 7) ----------------------------------
# The Neon database the deployed dashboard reads. Direct endpoint (the host
# WITHOUT `-pooler`): `ecom-scraper sync` does schema work and bulk inserts, and
# a pooler in transaction mode is the wrong place for either. Set, this is also
# the second destination the extension's Lokal/Neon toggle can write to.
NEON_DATABASE_URL=

# --- Telegram notifier trigger (README section 8) ----------------------------
# The dashboard that hosts /api/notify, and the secret it checks. Read by
# scripts/notify.sh AND by the ingest server: with both set, the server POSTs
# that route itself once its own writes have gone quiet for
# NOTIFY_QUIET_SECONDS. Leave NOTIFY_URL empty and only the launchd timer runs
# the notifier. Local, not the deployment — the notifier reads Postgres on this
# machine, which Vercel cannot reach.
NOTIFY_URL=
NOTIFY_SECRET=
NOTIFY_QUIET_SECONDS=180

# The same pair for the deployed dashboard, which reads NEON_DATABASE_URL. A
# batch the extension sends to the Neon destination runs this one instead — one
# dashboard reads one database, so a write to Neon is not news to the notifier
# reading Postgres here. No fallback to NOTIFY_SECRET above: these are two
# different deployments, and a fallback would send the local secret to a host on
# the internet because a variable was forgotten.
NEON_NOTIFY_URL=
NEON_NOTIFY_SECRET=
