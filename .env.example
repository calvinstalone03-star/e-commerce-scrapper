DATABASE_URL=postgresql://calvin@127.0.0.1:5432/ecom_scraper
SHOPEE_USERNAME=
SHOPEE_PASSWORD=
HEADLESS=true
MIN_DELAY=2.0
MAX_DELAY=5.0

# --- Shopee Affiliate Open API (supported route to keyword search) -----------
# Register at https://affiliate.shopee.co.id/ , then Open API section of the
# dashboard. When BOTH are set, the affiliate adapter is used for Shopee instead
# of web scraping. Web scraping cannot reach keyword search at all.
SHOPEE_AFFILIATE_APP_ID=
SHOPEE_AFFILIATE_APP_SECRET=
SHOPEE_AFFILIATE_REGION=id

# Ingest token for the browser extension (generated at .ingest-token if unset)
INGEST_TOKEN=

# Skip a snapshot identical to the previous one within this many hours (0 = always insert)
SNAPSHOT_DEDUPE_HOURS=24
